---
// 资料站编辑器 v2 —— 只动 src/content/docs/wiki/ 下的 Markdown
// 纯前端 + GitHub API，不需要后端服务
layout: false
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="no-referrer">
  <!-- 安全：只加载本站资源，只允许连 GitHub API -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src https://api.github.com; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'">
  <title>资料站编辑器</title>
  <link rel="stylesheet" href="/fonts/wenkai.css">
  <style>
    :root {
      --bg: #eef0f6; --panel: #fff; --line: #dcdfe8; --ink: #1a1a1a;
      --muted: #6b6b76; --accent: #6d5bd0; --accent-soft: #ece8f9;
      --ok: #2f8a4a; --warn: #b45309; --err: #c0392b;
      --mono: "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    }
    * { box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      margin: 0; background: var(--bg); color: var(--ink); font-size: 14px;
      font-family: "LXGW WenKai Screen", "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
      display: flex; flex-direction: column; overflow: hidden;
    }
    a { color: var(--accent); }
    button, input, textarea, select { font-family: inherit; }
    button {
      font-size: 12px; padding: 5px 11px; cursor: pointer; background: #fff;
      border: 1px solid var(--line); border-radius: 6px; transition: .13s;
    }
    button:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
    button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    button.primary:hover:not(:disabled) { filter: brightness(1.09); color: #fff; }
    button.danger:hover:not(:disabled) { border-color: var(--err); color: var(--err); }
    button:disabled { opacity: .45; cursor: not-allowed; }
    input[type=text], input[type=password], textarea, select {
      font-size: 12px; padding: 5px 9px; border: 1px solid var(--line);
      border-radius: 6px; background: #fff; color: var(--ink);
    }
    input:focus, textarea:focus { outline: 2px solid var(--accent-soft); border-color: var(--accent); }

    .top {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      padding: 9px 14px; background: var(--panel); border-bottom: 1px solid var(--line);
    }
    .top h1 { font-size: 15px; margin: 0; font-weight: 700; white-space: nowrap; }
    .top .back { font-size: 12px; color: var(--muted); text-decoration: none; white-space: nowrap; }
    .spacer { flex: 1; }
    #token { width: 270px; }
    .pill {
      display: inline-flex; align-items: center; gap: 5px; font-size: 12px;
      padding: 4px 10px; border-radius: 20px; background: #f1f2f6; color: var(--muted);
    }
    .pill.ok { background: #e8f5ec; color: var(--ok); }
    .pill.err { background: #fdecea; color: var(--err); }
    .pill label { display: inline-flex; align-items: center; gap: 4px; cursor: pointer; }
    .dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }

    .layout { flex: 1; display: grid; grid-template-columns: 250px 1fr; min-height: 0; }
    .side {
      background: var(--panel); border-right: 1px solid var(--line);
      display: flex; flex-direction: column; min-height: 0;
    }
    .side__bar { padding: 8px; border-bottom: 1px solid var(--line); display: flex; gap: 6px; }
    .side__bar input { flex: 1; min-width: 0; }
    .tree { list-style: none; margin: 0; padding: 6px; overflow: auto; flex: 1; }
    .tree .grp { font-size: 11px; color: var(--muted); padding: 8px 8px 3px; letter-spacing: .04em; }
    .tree li.item {
      padding: 5px 8px; border-radius: 6px; cursor: pointer; font-size: 12.5px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .tree li.item:hover { background: var(--accent-soft); }
    .tree li.item.on { background: var(--accent); color: #fff; }

    .main { display: flex; flex-direction: column; min-height: 0; }
    .tabs { display: flex; gap: 4px; padding: 8px 12px 0; background: var(--panel); align-items: flex-end; }
    .tabs .spacer { flex: 1; }
    .tabs button { border-radius: 6px 6px 0 0; background: #f6f7fa; }
    .tabs button.on { background: #fff; color: var(--accent); font-weight: 600; }

    .toolbar {
      display: flex; align-items: center; gap: 2px; flex-wrap: wrap;
      padding: 6px 12px; background: var(--panel); border-bottom: 1px solid var(--line);
    }
    .toolbar button {
      min-width: 30px; padding: 4px 7px; border-color: transparent; background: transparent; font-size: 13px;
    }
    .toolbar button:hover:not(:disabled) { background: var(--accent-soft); border-color: transparent; }
    .toolbar .sep { width: 1px; height: 18px; background: var(--line); margin: 0 5px; }
    .toolbar .spacer { flex: 1; }
    .toolbar .lb { font-size: 11px; color: var(--muted); padding: 0 4px; }

    .pane { flex: 1; display: grid; grid-template-columns: 1fr 1fr; min-height: 0; }
    .pane.single { grid-template-columns: 1fr; }
    .pane.single .preview { display: none; }
    #md {
      border: 0; border-radius: 0; resize: none; padding: 14px 18px; width: 100%; height: 100%;
      font-family: var(--mono); font-size: 13px; line-height: 1.8; background: var(--panel); tab-size: 2;
    }
    #md:focus { outline: 0; }
    .preview { border-left: 1px solid var(--line); background: #fff; }
    .preview iframe { width: 100%; height: 100%; border: 0; display: block; }

    .savebar {
      display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
      padding: 8px 12px; background: var(--panel); border-top: 1px solid var(--line);
    }
    .savebar #summary { flex: 1; min-width: 170px; }
    .stat { font-size: 12px; color: var(--muted); white-space: nowrap; }
    .stat.dirty { color: var(--warn); }
    .stat.ok { color: var(--ok); }

    .panel { flex: 1; overflow: auto; padding: 18px 20px; background: var(--panel); }
    .panel h2 { font-size: 14px; margin: 0 0 12px; }
    .rev { border-bottom: 1px solid var(--line); padding: 10px 0; display: flex; gap: 12px; align-items: baseline; }
    .rev time { font-size: 12px; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
    .rev .msg { flex: 1; font-size: 13px; }
    .rev .sha { font-family: var(--mono); font-size: 11px; color: var(--muted); }
    .field { display: flex; gap: 10px; align-items: center; margin-bottom: 12px; flex-wrap: wrap; }
    .field label { width: 74px; font-size: 13px; color: var(--muted); }
    .field input[type=text] { flex: 1; min-width: 200px; }
    .note { font-size: 12px; color: var(--muted); line-height: 1.95; }
    .note code, .warnbox code { background: #f2f2f6; padding: 1px 5px; border-radius: 4px; font-family: var(--mono); }
    .warnbox {
      background: #fff8e6; border: 1px solid #f0dca8; color: #7a5b12;
      padding: 12px 14px; border-radius: 8px; font-size: 12.5px; line-height: 1.95; margin-bottom: 16px;
    }

    dialog { border: 0; border-radius: 10px; padding: 0; width: min(580px, 92vw); box-shadow: 0 18px 50px #0003; }
    dialog::backdrop { background: #0006; }
    .dlg__head { padding: 12px 16px; border-bottom: 1px solid var(--line); font-weight: 700; font-size: 14px; }
    .dlg__body { padding: 14px 16px; max-height: 62vh; overflow: auto; }
    .dlg__foot { padding: 10px 16px; border-top: 1px solid var(--line); display: flex; gap: 8px; justify-content: flex-end; }
    .dlg__foot .left { margin-right: auto; }
    .imgpick { display: grid; grid-template-columns: repeat(auto-fill, minmax(84px, 1fr)); gap: 8px; }
    .imgpick button { padding: 3px; border-radius: 8px; }
    .imgpick img { width: 100%; height: 66px; object-fit: cover; border-radius: 6px; display: block; }
    .imgpick .nm { font-size: 10px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pagelist { max-height: 230px; overflow: auto; border: 1px solid var(--line); border-radius: 8px; }
    .pagelist button {
      display: block; width: 100%; text-align: left; border: 0; border-radius: 0;
      border-bottom: 1px solid var(--line); padding: 7px 10px;
    }
    .pagelist button:hover { background: var(--accent-soft); }
    .empty { color: var(--muted); padding: 40px 20px; text-align: center; font-size: 13px; line-height: 2; }

    @media (max-width: 900px) {
      .layout { grid-template-columns: 1fr; grid-template-rows: auto 1fr; }
      .side { max-height: 28vh; border-right: 0; border-bottom: 1px solid var(--line); }
      .pane { grid-template-columns: 1fr; }
      .preview { display: none; }
      #token { width: 150px; }
    }
  </style>
</head>
<body data-pagefind-ignore>

<div class="top">
  <h1>资料站编辑器</h1>
  <a class="back" href="/">← 回站点</a>
  <span class="spacer"></span>
  <input type="password" id="token" placeholder="GitHub Token（ghp_… 或 github_pat_…）" autocomplete="off">
  <span class="pill"><label><input type="checkbox" id="remember"> 记住本机</label></span>
  <button id="connect">连接</button>
  <button id="lock" title="立即清除本机保存的 token">锁定</button>
  <span class="pill" id="status"><span class="dot"></span>未连接</span>
</div>

<div class="layout">
  <aside class="side">
    <div class="side__bar">
      <input type="text" id="filter" placeholder="筛选页面…">
      <button id="new" title="新建页面">＋</button>
    </div>
    <ul class="tree" id="tree"><li class="empty">连接后显示页面列表</li></ul>
  </aside>

  <main class="main">
    <div class="tabs">
      <button class="on" data-tab="edit">编辑</button>
      <button data-tab="history">历史</button>
      <button data-tab="settings">页面设置 / 安全</button>
      <span class="spacer"></span>
      <button id="openPreview" title="在新窗口打开线上页面">↗ 看线上效果</button>
    </div>

    <div class="toolbar" id="editorBar">
      <button data-act="bold" title="粗体 (Ctrl+B)"><b>B</b></button>
      <button data-act="italic" title="斜体 (Ctrl+I)"><i>I</i></button>
      <button data-act="strike" title="删除线"><s>S</s></button>
      <button data-act="code" title="行内代码">&#96;&#96;</button>
      <span class="sep"></span>
      <button data-act="h2" title="二级标题">H2</button>
      <button data-act="h3" title="三级标题">H3</button>
      <span class="sep"></span>
      <button data-act="link" title="插入链接 (Ctrl+K)">🔗</button>
      <button data-act="table" title="插入表格">▦</button>
      <button data-act="image" title="插入图片">🖼</button>
      <span class="sep"></span>
      <button data-act="ul" title="无序列表">•</button>
      <button data-act="ol" title="有序列表">1.</button>
      <button data-act="quote" title="引用">❝</button>
      <button data-act="hr" title="分隔线">―</button>
      <span class="sep"></span>
      <button data-act="details" title="折叠区块">▸ 折叠</button>
      <button data-act="infobox" title="信息卡（迁移页面常用）">▤ 信息卡</button>
      <span class="spacer"></span>
      <span class="lb" id="cursorInfo"></span>
      <button id="togglePane" title="只看编辑 / 显示预览">◫</button>
    </div>

    <div class="pane" id="pane">
      <textarea id="md" spellcheck="false" placeholder="从左侧选一个页面，或点「＋」新建…"></textarea>
      <div class="preview"><!-- sandbox 只给 allow-same-origin：不给 allow-scripts，脚本依然跑不起来；
           同时沙箱文档才拿得到同源身份，不会被 CSP 的 frame-src self 拦掉 -->
      <iframe id="pv" sandbox="allow-same-origin" referrerpolicy="no-referrer" title="预览"></iframe></div>
    </div>

    <div class="panel" id="historyPanel" hidden>
      <h2>页面历史</h2>
      <p class="note">每次保存都是一次 git 提交。点「恢复此版本」会把那一版内容载入编辑区，仍需点保存才生效。</p>
      <div id="revList"><p class="note">选择一个页面后显示。</p></div>
    </div>

    <div class="panel" id="settingsPanel" hidden>
      <h2>页面设置</h2>
      <div class="field"><label>标题</label><input type="text" id="fmTitle" placeholder="页面标题"></div>
      <div class="field"><label>标签</label><input type="text" id="fmTags" placeholder="用逗号分隔，例如：蓝人组, I人"></div>
      <div class="field"><label>路径</label><input type="text" id="fmPath" readonly></div>
      <p class="note">改标题或标签会直接改写正文顶部的 frontmatter。</p>
      <hr style="border:0;border-top:1px solid var(--line);margin:20px 0">
      <h2>安全说明</h2>
      <div class="warnbox">
        <b>token 怎么给最安全</b><br>
        · 用 <b>fine-grained token</b>，只授权这一个仓库的 <code>Contents: Read and write</code>，别给全账号权限<br>
        · 不勾「记住本机」时，token 只存在 <code>sessionStorage</code>，关掉浏览器即失效<br>
        · 用完随时点「锁定」，立刻清除本机保存的 token<br>
        · 万一泄露，去 GitHub 设置里直接吊销即可，本页面不留任何密钥
      </div>
      <div class="warnbox">
        <b>这个页面本身做了哪些防护</b><br>
        · 严格 <b>CSP</b>：只允许连 <code>api.github.com</code>，禁 object / 外链 frame / 表单提交<br>
        · 预览走 <b>沙箱 iframe</b>，HTML 先进 <b>DOMPurify</b> 净化 —— 正文里就算有 <code>&lt;script&gt;</code> 也不会执行<br>
        · <code>referrer: no-referrer</code>；页面 noindex 并写进 robots.txt<br>
        · 无后端：所有请求由你的浏览器直连 GitHub，不经过任何第三方
      </div>
      <p class="note">
        创建 fine-grained token：<br>
        <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">github.com/settings/personal-access-tokens/new</a><br>
        Repository access → <code>Only select repositories</code> → <code>DannyParticle.github.io</code><br>
        Permissions → Repository permissions → <code>Contents</code> = <b>Read and write</b>，其余全部 No access
      </p>
    </div>

    <div class="savebar">
      <span class="stat" id="pathLabel">未选择页面</span>
      <input type="text" id="summary" placeholder="编辑摘要（作为 commit message）">
      <span class="stat" id="counter"></span>
      <span class="stat" id="dirtyState"></span>
      <button id="revert" disabled>还原</button>
      <button class="danger" id="remove" disabled>删除</button>
      <button class="primary" id="save" disabled>保存</button>
    </div>
  </main>
</div>

<dialog id="dlgLink">
  <div class="dlg__head">插入链接</div>
  <div class="dlg__body">
    <div class="field"><label>显示文字</label><input type="text" id="linkText" placeholder="留空则用页面名"></div>
    <div class="field"><label>找页面</label><input type="text" id="linkSearch" placeholder="搜索资料站页面…"></div>
    <div class="pagelist" id="linkPages"></div>
    <div class="field" style="margin-top:14px"><label>或外链</label><input type="text" id="linkUrl" placeholder="https://…"></div>
  </div>
  <div class="dlg__foot"><button class="left" id="linkCancel">取消</button><button class="primary" id="linkOk">插入</button></div>
</dialog>

<dialog id="dlgTable">
  <div class="dlg__head">插入表格</div>
  <div class="dlg__body">
    <div class="field"><label>列数</label><input type="text" id="tbCols" value="3"></div>
    <div class="field"><label>数据行数</label><input type="text" id="tbRows" value="3"></div>
    <div class="field"><label>首行表头</label><input type="checkbox" id="tbHead" checked></div>
  </div>
  <div class="dlg__foot"><button class="left" id="tbCancel">取消</button><button class="primary" id="tbOk">插入</button></div>
</dialog>

<dialog id="dlgImage">
  <div class="dlg__head">插入图片</div>
  <div class="dlg__body">
    <div class="field"><label>上传新图</label><input type="file" id="imgFile" accept="image/*"></div>
    <p class="note" style="margin:0 0 14px">上传会放进 <code>/wiki-images/</code>；也可以直接从下面已有的图里挑一张。</p>
    <div class="field"><label>说明文字</label><input type="text" id="imgAlt" placeholder="可选，图片说明"></div>
    <div class="imgpick" id="imgPick"></div>
  </div>
  <div class="dlg__foot"><button class="left" id="imgCancel">取消</button></div>
</dialog>

<script>
  import { marked } from 'marked';
  import DOMPurify from 'dompurify';

  const OWNER = 'DannyParticle';
  const REPO = 'DannyParticle.github.io';
  const BRANCH = 'main';
  const WIKI_DIR = 'src/content/docs/wiki/';
  const IMG_DIR = 'public/wiki-images/';
  const TOKEN_KEY = 'dsh_wiki_token';
  const SITE = 'https://dannyparticle.github.io';

  const $ = (id) => document.getElementById(id);
  const el = {
    token: $('token'), remember: $('remember'), status: $('status'),
    tree: $('tree'), filter: $('filter'),
    md: $('md'), pv: $('pv'), pane: $('pane'), cursor: $('cursorInfo'),
    pathLabel: $('pathLabel'), summary: $('summary'), counter: $('counter'),
    dirty: $('dirtyState'), save: $('save'), revert: $('revert'), remove: $('remove'),
    revList: $('revList'), historyPanel: $('historyPanel'), settingsPanel: $('settingsPanel'),
    fmTitle: $('fmTitle'), fmTags: $('fmTags'), fmPath: $('fmPath'),
  };

  let token = sessionStorage.getItem(TOKEN_KEY) || localStorage.getItem(TOKEN_KEY) || '';
  let remembered = !sessionStorage.getItem(TOKEN_KEY) && !!localStorage.getItem(TOKEN_KEY);
  let files = [];
  let current = null;
  let original = '';
  let allImages = [];
  let targetLink = null;

  const setStatus = (text, cls = '') => {
    el.status.className = 'pill ' + cls;
    el.status.innerHTML = '<span class="dot"></span>' + text;
  };
  const b64encode = (str) => {
    const bytes = new TextEncoder().encode(str);
    let bin = '';
    for (let i = 0; i < bytes.length; i += 0x8000) bin += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
    return btoa(bin);
  };
  const b64decode = (b64) => {
    const bin = atob(b64.replace(/\s/g, ''));
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return new TextDecoder().decode(bytes);
  };
  const esc = (s) => DOMPurify.sanitize(String(s));

  async function api(path, options = {}) {
    const res = await fetch('https://api.github.com' + path, {
      ...options,
      headers: {
        Authorization: 'Bearer ' + token,
        Accept: 'application/vnd.github+json',
        'X-GitHub-Api-Version': '2022-11-28',
        ...(options.body ? { 'Content-Type': 'application/json' } : {}),
      },
    });
    const text = await res.text();
    const data = text ? JSON.parse(text) : {};
    if (!res.ok) throw new Error(`${res.status} ${data.message || res.statusText}`);
    return data;
  }

  // ---------- 预览：净化 + 沙箱 iframe ----------
  const PREVIEW_CSS = `
    body{margin:0;padding:14px 18px;line-height:1.8;color:#1a1a1a;
      font-family:"LXGW WenKai Screen","PingFang SC","Microsoft YaHei",system-ui,sans-serif}
    h1{font-size:1.5em}h2{font-size:1.25em;border-bottom:1px solid #e3e3e8;padding-bottom:.3em}
    table{border-collapse:collapse;display:block;overflow-x:auto;max-width:100%}
    th,td{border:1px solid #e3e3e8;padding:4px 9px}th{background:#f3f3f7}
    img{max-width:100%;height:auto}
    code{background:#f2f2f6;padding:1px 5px;border-radius:4px;font-family:monospace}
    pre{background:#f7f7fa;padding:10px;border-radius:6px;overflow:auto}pre code{background:none;padding:0}
    blockquote{border-left:3px solid #e3e3e8;margin-left:0;padding-left:12px;color:#6b6b76}
    details{border:1px solid #e3e3e8;border-radius:6px;padding:8px 12px;margin:10px 0}
    summary{cursor:pointer;font-weight:600}
    a{color:#6d5bd0}
    .wiki-infobox{border:1px solid #e3e3e8;border-radius:8px;border-collapse:separate;border-spacing:0;
      table-layout:fixed;width:min(21rem,60%);float:right;margin:0 0 12px 16px;font-size:.85em;overflow:hidden}
    .wiki-infobox th,.wiki-infobox td{border:0;border-top:1px solid #e3e3e8;padding:6px 9px;vertical-align:top}
    .wiki-infobox th{background:#f3f3f7;text-align:left;width:6rem}
    .wiki-infobox tr:first-child th,.wiki-infobox tr:first-child td{border-top:0}
    .wiki-infobox-figure{text-align:center;background:#f7f7fa}
    .wiki-infobox-figure img{max-height:16rem;width:auto}
    .wiki-gallery{columns:3 8rem;column-gap:.7rem}
    .wiki-gallery figure{break-inside:avoid;margin:0 0 .7rem;border:1px solid #e3e3e8;border-radius:8px;padding:.3rem}
    .wiki-gallery img{width:100%;height:auto}
    .wiki-gallery figcaption{font-size:.7em;text-align:center;color:#6b6b76}
  `;

  function render() {
    let html = '';
    try { html = marked.parse(el.md.value || ''); } catch (e) { html = '<p>（Markdown 解析出错）</p>'; }
    const safe = DOMPurify.sanitize(html, {
      FORBID_TAGS: ['script', 'style', 'iframe', 'object', 'embed', 'form', 'link', 'meta'],
      FORBID_ATTR: ['onerror', 'onload', 'onclick', 'srcdoc'],
    });
    el.pv.srcdoc = `<!doctype html><html lang="zh-CN"><head><meta charset="utf-8">
      <base target="_blank"><style>${PREVIEW_CSS}</style></head><body>${safe}</body></html>`;
  }

  function refreshState() {
    const dirty = el.md.value !== original;
    el.dirty.textContent = dirty ? '● 有未保存的修改' : (current ? '已同步' : '');
    el.dirty.className = 'stat ' + (dirty ? 'dirty' : (current ? 'ok' : ''));
    el.revert.disabled = !dirty;
    el.counter.textContent = `${el.md.value.length} 字符 · ${el.md.value.split('\n').length} 行`;
  }
  const touch = () => { render(); refreshState(); };

  // ---------- 连接 ----------
  async function connect(silent = false) {
    if (!token) { setStatus('未连接'); return; }
    setStatus('连接中…');
    try {
      const me = await api('/user');
      if (el.remember.checked) {
        localStorage.setItem(TOKEN_KEY, token);
        sessionStorage.removeItem(TOKEN_KEY);
      } else {
        sessionStorage.setItem(TOKEN_KEY, token);
        localStorage.removeItem(TOKEN_KEY);
      }
      setStatus(`已连接 ${me.login}`, 'ok');
      await loadTree();
      loadImages().catch(() => {});
    } catch (e) {
      setStatus('连接失败', 'err');
      if (!silent) alert('连接失败：' + e.message + '\n\n确认 token 有效，且对本站仓库有 Contents 读写权限。');
    }
  }

  async function loadTree() {
    const tree = await api(`/repos/${OWNER}/${REPO}/git/trees/${BRANCH}?recursive=1`);
    files = tree.tree
      .filter((n) => n.type === 'blob' && n.path.startsWith(WIKI_DIR) && n.path.endsWith('.md'))
      .map((n) => n.path).sort();
    setStatus(`已连接 · ${files.length} 个页面`, 'ok');
    drawTree();
  }

  function drawTree() {
    const q = el.filter.value.trim().toLowerCase();
    const groups = new Map();
    files.forEach((p) => {
      const rel = p.slice(WIKI_DIR.length);
      if (q && !rel.toLowerCase().includes(q)) return;
      const parts = rel.split('/');
      const grp = parts.length > 1 ? parts.slice(0, -1).join('/') : '（根目录）';
      if (!groups.has(grp)) groups.set(grp, []);
      groups.get(grp).push({ path: p, name: parts[parts.length - 1].replace(/\.md$/, '') });
    });
    el.tree.innerHTML = '';
    if (!groups.size) { el.tree.innerHTML = '<li class="empty">没有匹配的页面</li>'; return; }
    for (const [grp, items] of groups) {
      const h = document.createElement('li');
      h.className = 'grp'; h.textContent = grp;
      el.tree.appendChild(h);
      items.forEach((it) => {
        const row = document.createElement('li');
        row.className = 'item' + (current && current.path === it.path ? ' on' : '');
        row.textContent = it.name;
        row.title = it.path.slice(WIKI_DIR.length);
        row.onclick = () => openFile(it.path);
        el.tree.appendChild(row);
      });
    }
  }

  // ---------- frontmatter ----------
  function parseFrontmatter(text) {
    const m = /^---\n([\s\S]*?)\n---\n?/.exec(text);
    if (!m) return { title: '', tags: '' };
    const title = (/^title:\s*"?(.*?)"?\s*$/m.exec(m[1]) || [])[1] || '';
    const tagsRaw = (/^tags:\s*\n((?:\s*-\s*.+\n?)+)/m.exec(m[1]) || [])[1] || '';
    const tags = tagsRaw.split('\n')
      .map((s) => s.replace(/^\s*-\s*/, '').replace(/^"|"$/g, '').trim())
      .filter(Boolean).join(', ');
    return { title, tags };
  }
  function applyFrontmatter(title, tags) {
    const text = el.md.value;
    const m = /^---\n([\s\S]*?)\n---\n?/.exec(text);
    const body = m ? text.slice(m[0].length) : text;
    const list = tags.split(',').map((s) => s.trim()).filter(Boolean);
    let fm = `---\ntitle: ${JSON.stringify(title || '未命名')}\n`;
    if (list.length) fm += 'tags:\n' + list.map((t) => `  - ${JSON.stringify(t)}\n`).join('');
    fm += '---\n\n';
    el.md.value = fm + body.replace(/^\n+/, '');
    touch();
  }

  // ---------- 打开 / 保存 ----------
  async function openFile(path) {
    if (el.md.value !== original && !confirm('当前页面有未保存的修改，确定切换？')) return;
    setStatus('读取中…');
    try {
      const data = await api(`/repos/${OWNER}/${REPO}/contents/${encodeURI(path)}?ref=${BRANCH}`);
      current = { path, sha: data.sha };
      original = b64decode(data.content);
      el.md.value = original;
      const rel = path.slice(WIKI_DIR.length);
      el.pathLabel.textContent = rel;
      el.fmPath.value = rel;
      const fm = parseFrontmatter(original);
      el.fmTitle.value = fm.title;
      el.fmTags.value = fm.tags;
      el.save.disabled = false; el.remove.disabled = false;
      el.summary.value = '';
      touch(); drawTree(); loadHistory();
      setStatus(`已打开 · ${files.length} 个页面`, 'ok');
    } catch (e) { setStatus('打不开', 'err'); alert('打不开这个页面：' + e.message); }
  }

  async function save() {
    if (!current) return;
    el.save.disabled = true;
    setStatus('提交中…');
    try {
      const rel = current.path.slice(WIKI_DIR.length);
      const body = {
        message: el.summary.value.trim() || `编辑资料站：${rel}`,
        content: b64encode(el.md.value),
        branch: BRANCH,
      };
      if (current.sha) body.sha = current.sha;
      const res = await api(`/repos/${OWNER}/${REPO}/contents/${encodeURI(current.path)}`, {
        method: 'PUT', body: JSON.stringify(body),
      });
      current.sha = res.content.sha;
      original = el.md.value;
      refreshState(); loadHistory();
      el.summary.value = '';
      setStatus('已提交，构建中', 'ok');
      alert('已提交 ✓\n\nGitHub Actions 会自动重建，约 1 分钟后线上生效。');
    } catch (e) {
      setStatus('提交失败', 'err');
      alert('提交失败：' + e.message);
    } finally { el.save.disabled = false; }
  }

  async function createFile() {
    const rel = prompt('新页面路径（相对资料站根目录）\n例如：characters/xin-juese', 'misc/新页面');
    if (!rel) return;
    const path = WIKI_DIR + rel.replace(/^\/+/, '').replace(/\.md$/, '') + '.md';
    if (files.includes(path)) { alert('这个路径已存在'); return; }
    const title = prompt('页面标题', rel.split('/').pop());
    if (!title) return;
    const tpl = `---\ntitle: ${JSON.stringify(title)}\n---\n\n在这里写内容。\n`;
    setStatus('创建中…');
    try {
      await api(`/repos/${OWNER}/${REPO}/contents/${encodeURI(path)}`, {
        method: 'PUT',
        body: JSON.stringify({ message: `新建资料站页面：${title}`, content: b64encode(tpl), branch: BRANCH }),
      });
      await loadTree();
      original = '';
      await openFile(path);
      setStatus('已创建', 'ok');
    } catch (e) { setStatus('创建失败', 'err'); alert('创建失败：' + e.message); }
  }

  async function removeFile() {
    if (!current) return;
    const rel = current.path.slice(WIKI_DIR.length);
    if (!confirm(`确定删除「${rel}」？内容仍可从历史里找回。`)) return;
    if (prompt('再确认一次：输入 DELETE 才会删除') !== 'DELETE') return;
    setStatus('删除中…');
    try {
      await api(`/repos/${OWNER}/${REPO}/contents/${encodeURI(current.path)}`, {
        method: 'DELETE',
        body: JSON.stringify({
          message: el.summary.value.trim() || `删除资料站页面：${rel}`,
          sha: current.sha, branch: BRANCH,
        }),
      });
      current = null; original = ''; el.md.value = '';
      el.pathLabel.textContent = '未选择页面';
      el.save.disabled = true; el.remove.disabled = true;
      touch(); await loadTree();
      setStatus('已删除', 'ok');
    } catch (e) { setStatus('删除失败', 'err'); alert('删除失败：' + e.message); }
  }

  // ---------- 历史 ----------
  async function loadHistory() {
    if (!current) { el.revList.innerHTML = '<p class="note">选择一个页面后显示。</p>'; return; }
    el.revList.innerHTML = '<p class="note">读取中…</p>';
    try {
      const commits = await api(
        `/repos/${OWNER}/${REPO}/commits?path=${encodeURIComponent(current.path)}&sha=${BRANCH}&per_page=30`);
      if (!commits.length) { el.revList.innerHTML = '<p class="note">还没有提交记录。</p>'; return; }
      el.revList.innerHTML = '';
      commits.forEach((c) => {
        const d = new Date(c.commit.author.date);
        const pad = (n) => String(n).padStart(2, '0');
        const div = document.createElement('div');
        div.className = 'rev';
        div.innerHTML = `<time>${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}</time>
          <span class="msg">${esc(c.commit.message.split('\n')[0])} <span class="sha">${c.sha.slice(0, 7)}</span></span>
          <button>恢复此版本</button>
          <a href="${c.html_url}" target="_blank" rel="noopener noreferrer" class="sha">diff</a>`;
        div.querySelector('button').onclick = () => restoreVersion(c.sha);
        el.revList.appendChild(div);
      });
    } catch (e) { el.revList.innerHTML = `<p class="note">读取历史失败：${esc(e.message)}</p>`; }
  }

  async function restoreVersion(sha) {
    if (!current) return;
    if (!confirm('把这一版内容载入编辑区？还需要点「保存」才生效。')) return;
    try {
      const data = await api(`/repos/${OWNER}/${REPO}/contents/${encodeURI(current.path)}?ref=${sha}`);
      el.md.value = b64decode(data.content);
      el.summary.value = `恢复到 ${sha.slice(0, 7)} 的版本`;
      tab('edit'); touch();
      setStatus('已载入历史版本', 'ok');
    } catch (e) { alert('载入失败：' + e.message); }
  }

  // ---------- 编辑操作 ----------
  function surround(before, after = before, placeholder = '') {
    const t = el.md, s = t.selectionStart, e = t.selectionEnd;
    const sel = t.value.slice(s, e) || placeholder;
    t.value = t.value.slice(0, s) + before + sel + after + t.value.slice(e);
    t.selectionStart = s + before.length;
    t.selectionEnd = s + before.length + sel.length;
    t.focus(); touch();
  }
  function prefixLines(fn) {
    const t = el.md;
    const s = t.value.lastIndexOf('\n', t.selectionStart - 1) + 1;
    let e = t.value.indexOf('\n', t.selectionEnd);
    if (e === -1) e = t.value.length;
    const block = t.value.slice(s, e).split('\n').map(fn).join('\n');
    t.value = t.value.slice(0, s) + block + t.value.slice(e);
    t.selectionStart = s; t.selectionEnd = s + block.length;
    t.focus(); touch();
  }
  function insert(text) {
    const t = el.md, s = t.selectionStart;
    t.value = t.value.slice(0, s) + text + t.value.slice(t.selectionEnd);
    t.selectionStart = t.selectionEnd = s + text.length;
    t.focus(); touch();
  }

  const actions = {
    bold: () => surround('**', '**', '粗体'),
    italic: () => surround('*', '*', '斜体'),
    strike: () => surround('~~', '~~', '删除线'),
    code: () => surround('`', '`', 'code'),
    h2: () => prefixLines((l) => '## ' + l.replace(/^#+\s*/, '')),
    h3: () => prefixLines((l) => '### ' + l.replace(/^#+\s*/, '')),
    ul: () => prefixLines((l) => '- ' + l.replace(/^[-*]\s*/, '')),
    ol: () => prefixLines((l, i) => `${i + 1}. ` + l.replace(/^\d+\.\s*/, '')),
    quote: () => prefixLines((l) => '> ' + l),
    hr: () => insert('\n\n---\n\n'),
    details: () => insert('\n<details>\n<summary>点开看</summary>\n\n内容\n\n</details>\n'),
    infobox: () => insert('\n<table class="wiki-infobox"><colgroup><col class="wiki-col-label"><col class="wiki-col-value"></colgroup>\n<tr><td class="wiki-infobox-figure" colspan="2"><img src="/wiki-images/xxx.webp" alt=""></td></tr>\n<tr><th>简介</th><td></td></tr>\n</table>\n'),
    link: () => openLinkDialog(),
    table: () => { $('dlgTable').showModal(); $('tbCols').focus(); },
    image: () => openImageDialog(),
  };

  // ---------- 链接 ----------
  function openLinkDialog() {
    const t = el.md;
    $('linkText').value = t.value.slice(t.selectionStart, t.selectionEnd) || '';
    $('linkUrl').value = ''; $('linkSearch').value = ''; targetLink = null;
    drawLinkPages(); $('dlgLink').showModal(); $('linkSearch').focus();
  }
  function drawLinkPages() {
    const q = $('linkSearch').value.trim().toLowerCase();
    const box = $('linkPages');
    box.innerHTML = '';
    files.filter((p) => !q || p.toLowerCase().includes(q)).slice(0, 200).forEach((p) => {
      const rel = p.slice(WIKI_DIR.length).replace(/\.md$/, '');
      const b = document.createElement('button');
      b.textContent = '/wiki/' + rel + '/';
      b.onclick = () => {
        targetLink = '/wiki/' + rel + '/';
        [...box.children].forEach((c) => (c.style.background = ''));
        b.style.background = 'var(--accent-soft)';
        if (!$('linkText').value) $('linkText').value = rel.split('/').pop();
      };
      box.appendChild(b);
    });
  }

  // ---------- 表格 ----------
  function makeTable() {
    const cols = Math.max(1, Math.min(20, parseInt($('tbCols').value, 10) || 3));
    const rows = Math.max(1, Math.min(50, parseInt($('tbRows').value, 10) || 3));
    const head = $('tbHead').checked;
    const lines = ['| ' + Array.from({ length: cols }, (_, i) => head ? `列${i + 1}` : ' ').join(' | ') + ' |'];
    lines.push('|' + '---|'.repeat(cols));
    for (let r = 0; r < rows; r++) lines.push('| ' + Array.from({ length: cols }, () => ' ').join(' | ') + ' |');
    insert('\n\n' + lines.join('\n') + '\n\n');
  }

  // ---------- 图片 ----------
  async function loadImages() {
    const tree = await api(`/repos/${OWNER}/${REPO}/git/trees/${BRANCH}?recursive=1`);
    allImages = tree.tree
      .filter((n) => n.type === 'blob' && n.path.startsWith(IMG_DIR))
      .map((n) => n.path.slice(IMG_DIR.length))
      .filter((n) => /\.(png|jpe?g|gif|webp|svg|ico)$/i.test(n)).sort();
  }
  function openImageDialog() {
    const pick = $('imgPick');
    pick.innerHTML = allImages.length ? '' : '<p class="note">还没有图片，直接上传一张。</p>';
    allImages.slice(0, 240).forEach((name) => {
      const b = document.createElement('button');
      b.title = name;
      b.innerHTML = `<img src="/wiki-images/${encodeURIComponent(name)}" alt="" loading="lazy"><div class="nm">${esc(name)}</div>`;
      b.onclick = () => { insertImage(name); $('dlgImage').close(); };
      pick.appendChild(b);
    });
    $('dlgImage').showModal();
  }
  function insertImage(name) {
    const alt = $('imgAlt').value.trim() || name;
    insert(`\n<img src="/wiki-images/${name}" alt="${alt}">\n`);
  }
  async function uploadImage(file) {
    const safeName = prompt('图片文件名（放到 /wiki-images/ 下）', file.name);
    if (!safeName) return;
    setStatus('上传图片…');
    try {
      const buf = new Uint8Array(await file.arrayBuffer());
      let bin = '';
      for (let i = 0; i < buf.length; i += 0x8000) bin += String.fromCharCode.apply(null, buf.subarray(i, i + 0x8000));
      const path = IMG_DIR + safeName;
      let sha;
      try {
        const ex = await api(`/repos/${OWNER}/${REPO}/contents/${encodeURI(path)}?ref=${BRANCH}`);
        sha = ex.sha;
        if (!confirm(`${safeName} 已存在，覆盖？`)) return;
      } catch { /* 新文件 */ }
      await api(`/repos/${OWNER}/${REPO}/contents/${encodeURI(path)}`, {
        method: 'PUT',
        body: JSON.stringify({
          message: `上传资料站图片：${safeName}`,
          content: btoa(bin), branch: BRANCH, ...(sha ? { sha } : {}),
        }),
      });
      allImages.push(safeName);
      insertImage(safeName);
      $('dlgImage').close();
      setStatus('图片已上传', 'ok');
    } catch (e) { setStatus('图片上传失败', 'err'); alert('图片上传失败：' + e.message); }
  }

  // ---------- 标签页 ----------
  function tab(name) {
    document.querySelectorAll('.tabs button[data-tab]').forEach((b) => b.classList.toggle('on', b.dataset.tab === name));
    el.historyPanel.hidden = name !== 'history';
    el.settingsPanel.hidden = name !== 'settings';
    const editing = name === 'edit';
    $('editorBar').style.display = editing ? '' : 'none';
    el.pane.style.display = editing ? '' : 'none';
    el.save.style.display = editing ? '' : 'none';
    el.summary.style.display = editing ? '' : 'none';
    if (name === 'history') loadHistory();
    if (name === 'settings' && current) {
      const fm = parseFrontmatter(el.md.value);
      el.fmTitle.value = fm.title; el.fmTags.value = fm.tags;
    }
  }

  // ---------- 事件 ----------
  $('connect').onclick = () => { token = el.token.value.trim(); connect(); };
  $('lock').onclick = () => {
    localStorage.removeItem(TOKEN_KEY); sessionStorage.removeItem(TOKEN_KEY);
    token = ''; el.token.value = ''; files = []; current = null;
    el.md.value = ''; original = ''; el.pathLabel.textContent = '未选择页面';
    el.save.disabled = true; el.remove.disabled = true;
    drawTree(); refreshState(); setStatus('已锁定');
    alert('已从本机清除 token。');
  };
  el.filter.oninput = drawTree;
  el.save.onclick = save;
  $('new').onclick = createFile;
  el.remove.onclick = removeFile;
  el.revert.onclick = () => { if (confirm('放弃未保存的修改？')) { el.md.value = original; touch(); } };
  $('togglePane').onclick = () => el.pane.classList.toggle('single');
  $('openPreview').onclick = () => {
    if (!current) { alert('先选一个页面'); return; }
    window.open(SITE + '/wiki/' + current.path.slice(WIKI_DIR.length).replace(/\.md$/, '') + '/', '_blank', 'noopener');
  };
  document.querySelectorAll('.tabs button[data-tab]').forEach((b) => (b.onclick = () => tab(b.dataset.tab)));
  $('editorBar').addEventListener('click', (e) => {
    const b = e.target.closest('button[data-act]');
    if (b && actions[b.dataset.act]) actions[b.dataset.act]();
  });
  el.md.addEventListener('input', touch);
  ['click', 'keyup'].forEach((ev) => el.md.addEventListener(ev, () => {
    const upto = el.md.value.slice(0, el.md.selectionStart);
    el.cursor.textContent = `第 ${upto.split('\n').length} 行 第 ${el.md.selectionStart - upto.lastIndexOf('\n')} 列`;
  }));
  el.md.addEventListener('keydown', (e) => {
    const mod = e.ctrlKey || e.metaKey;
    if (mod && e.key === 's') { e.preventDefault(); save(); }
    else if (mod && e.key === 'b') { e.preventDefault(); actions.bold(); }
    else if (mod && e.key === 'i') { e.preventDefault(); actions.italic(); }
    else if (mod && e.key === 'k') { e.preventDefault(); actions.link(); }
    else if (e.key === 'Tab') { e.preventDefault(); insert('  '); }
  });
  window.addEventListener('beforeunload', (e) => {
    if (el.md.value !== original) { e.preventDefault(); e.returnValue = ''; }
  });
  $('linkSearch').oninput = drawLinkPages;
  $('linkCancel').onclick = () => $('dlgLink').close();
  $('linkOk').onclick = () => {
    const text = $('linkText').value.trim();
    const url = $('linkUrl').value.trim() || targetLink;
    if (!url) { alert('选一个站内页面，或填一个外链地址'); return; }
    insert(`[${text || url}](${url})`);
    $('dlgLink').close();
  };
  $('tbCancel').onclick = () => $('dlgTable').close();
  $('tbOk').onclick = () => { makeTable(); $('dlgTable').close(); };
  $('imgCancel').onclick = () => $('dlgImage').close();
  $('imgFile').onchange = (e) => { if (e.target.files[0]) uploadImage(e.target.files[0]); e.target.value = ''; };
  $('fmTitle').oninput = () => { if (current) applyFrontmatter(el.fmTitle.value, el.fmTags.value); };
  $('fmTags').oninput = () => { if (current) applyFrontmatter(el.fmTitle.value, el.fmTags.value); };

  // ---------- 启动 ----------
  el.remember.checked = remembered;
  if (token) { el.token.value = token; connect(true); } else setStatus('未连接');
  refreshState();
</script>
</body>
</html>
